{
  "name": "Personal Admin",
  "short_name": "Admin",
  "description": "Your insurances, contracts and bills, with renewal reminders. Stored only on this device.",
  "id": "./",
  "start_url": "./#/dashboard",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4F3EF",
  "theme_color": "#2F6FB3",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add from file", "url": "./#/inbox", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Everything", "url": "./#/items", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf", ".pdf",
            "message/rfc822", ".eml", ".msg", "application/vnd.ms-outlook",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document", ".docx",
            "text/plain", "text/html", ".txt",
            "text/csv", ".csv", "text/tab-separated-values", ".tsv",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", ".xlsx",
            "image/*"
          ]
        }
      ]
    }
  }
}
